# Environment variables for Cloudflare Pages
# Set these in: Cloudflare Dashboard -> Workers & Pages -> Your Project -> Settings -> Environment Variables

# URL of your Laravel API (Cloudflare custom domain or tunnel endpoint)
# Note: Do not include trailing slash
LARAVEL_API_URL=https://api.yourdomain.com

# Node.js version for Cloudflare Pages build environment
NODE_VERSION=20

# Optional: Currency for PayHere checkout
# NEXT_PUBLIC_PAYHERE_CURRENCY=LKR
